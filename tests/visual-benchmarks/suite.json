{
  "schemaVersion": "html-to-ios-visual-benchmark-suite-1.0",
  "target": {
    "width": 393,
    "height": 852,
    "device": "iPhone 16",
    "minimumIOS": "16.0"
  },
  "cases": [
    {
      "id": "system-controls",
      "html": "system-controls.html",
      "level": 1,
      "coverage": ["responsive-root", "text-field", "text-view", "search-field", "select", "switch", "segmented-control", "slider", "stepper", "progress", "page-control", "vertical-scroll"],
      "expectedNative": {
        "navigationTitleMode": "large",
        "contentContainerKinds": ["scroll-view", "compositional-collection"],
        "requiredUIKitControls": ["UITextField", "UITextView", "UISwitch", "UISegmentedControl", "UISlider", "UIStepper", "UIProgressView", "UIPageControl"],
        "requiredSwiftUIControls": ["TextField", "TextEditor", "Toggle", "Picker", "Slider", "Stepper", "ProgressView", "UIViewRepresentable"],
        "minimumSystemControlRatio": 1.0,
        "maximumCustomControlCount": 0
      }
    },
    {
      "id": "dashboard-list",
      "html": "dashboard-list.html",
      "level": 2,
      "coverage": ["custom-navigation", "table-view", "square-icons", "summary-card", "tab-bar", "vertical-scroll"],
      "expectedNative": {"navigationTitleMode": "large"}
    },
    {
      "id": "form-semantics",
      "html": "form-semantics.html",
      "level": 1,
      "coverage": ["responsive-root", "editable-input", "readonly-input", "disabled-input", "text-area", "datalist", "select", "bordered-display-label", "vertical-scroll"],
      "expectedNative": {
        "navigationTitleMode": "large",
        "requiredUIKitControls": ["UITextField", "UITextView", "UIButton"],
        "requiredSwiftUIControls": ["TextField", "TextEditor", "Picker"],
        "minimumSystemControlRatio": 1.0,
        "maximumCustomControlCount": 0
      }
    },
    {
      "id": "commerce-grid",
      "html": "commerce-grid.html",
      "level": 2,
      "coverage": ["responsive-root", "search-bar", "horizontal-collection", "grid-collection", "aspect-ratio", "tab-bar"]
    },
    {
      "id": "advanced-native-controls",
      "html": "advanced-native-controls.html",
      "level": 2,
      "coverage": ["responsive-root", "secure-input", "email-keyboard", "telephone-keyboard", "date-picker", "time-picker", "color-picker", "checkbox", "radio-group", "multi-select", "activity-indicator", "paste-control", "disclosure", "calendar-view", "vertical-scroll"],
      "expectedNative": {
        "navigationBarRendering": "native",
        "navigationTitleMode": "large",
        "contentContainerKinds": ["scroll-view", "compositional-collection"],
        "requiredUIKitControls": ["UITextField", "UIDatePicker", "UIColorWell", "UIButton", "UIActivityIndicatorView", "UIPasteControl", "UICalendarView"],
        "requiredSwiftUIControls": ["SecureField", "TextField", "DatePicker", "ColorPicker", "Toggle", "Menu", "ProgressView", "PasteButton", "UIViewRepresentable"],
        "minimumSystemControlRatio": 0.8,
        "maximumCustomControlCount": 4
      }
    },
    {
      "id": "settings-form",
      "html": "settings-form.html",
      "level": 2,
      "coverage": ["fixed-artboard", "custom-navigation", "text-field", "select", "switch", "segmented-control", "slider", "fixed-action-bar"],
      "expectedNative": {
        "navigationTitleMode": "inline",
        "requiredUIKitControls": ["UITextField", "UISwitch", "UISegmentedControl", "UISlider"],
        "requiredSwiftUIControls": ["TextField", "Toggle", "Picker", "Slider"],
        "minimumSystemControlRatio": 1.0,
        "maximumCustomControlCount": 0
      }
    },
    {
      "id": "article-detail",
      "html": "article-detail.html",
      "level": 2,
      "coverage": ["native-navigation", "long-form-text", "line-height", "aspect-ratio", "vertical-scroll", "fixed-action-bar"],
      "expectedNative": {
        "contentContainerKinds": ["scroll-view", "compositional-collection"],
        "navigationBarRendering": "native",
        "navigationTitleMode": "inline",
        "requiredUIKitControls": ["UIButton"],
        "requiredSwiftUIControls": ["Button"],
        "minimumSystemControlRatio": 1.0,
        "maximumCustomControlCount": 0
      }
    },
    {
      "id": "state-presentation",
      "html": "state-presentation.html",
      "level": 3,
      "coverage": ["fixed-artboard", "repeated-state-artboard", "state-deduplication", "sheet", "scrim", "detents", "dismiss", "square-icons"],
      "expectedNative": {
        "requiredUIKitControls": ["UIButton"],
        "requiredSwiftUIControls": ["Button"],
        "minimumSystemControlRatio": 1.0,
        "maximumCustomControlCount": 0
      }
    },
    {
      "id": "project-command-center",
      "html": "project-command-center.html",
      "level": 3,
      "coverage": ["native-inline-navigation", "fixed-action-bar", "vertical-scroll", "horizontal-collection", "table-view", "square-icons", "segmented-control", "text-field", "select", "switch", "asymmetric-corners", "nonuniform-layout"],
      "expectedNative": {
        "navigationBarRendering": "native",
        "navigationTitleMode": "inline",
        "requiredUIKitControls": ["UISegmentedControl", "UITextField", "UISwitch", "UIButton"],
        "requiredSwiftUIControls": ["Picker", "TextField", "Toggle", "Button"],
        "minimumSystemControlRatio": 0.8,
        "maximumCustomControlCount": 4
      }
    }
  ]
}
